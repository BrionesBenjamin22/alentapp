# Etapa 1: deps - Instalar dependencias
FROM node:22-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/api/package.json ./packages/api/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/web/package.json ./packages/web/package.json

RUN npm ci

# Etapa 2: build - Compilar frontend con Vite
FROM node:22-alpine AS build

WORKDIR /app

# Copiar dependencias instaladas
COPY --from=deps /app/node_modules ./node_modules

# Copiar manifests
COPY package.json package-lock.json ./
COPY tsconfig.json ./

# Copiar código compartido y frontend
COPY packages/shared ./packages/shared
COPY packages/web ./packages/web

# Compilar frontend
RUN npm run build -w packages/web

# Etapa 3: runtime - Servir archivos estáticos con nginx
FROM nginx:stable-alpine

# Copiar configuración de nginx
COPY packages/web/nginx.prod.conf /etc/nginx/conf.d/default.conf

# Copiar archivos compilados de Vite
COPY --from=build /app/packages/web/dist /usr/share/nginx/html

# Configuración para entorno sin privilegios (cap_drop: ALL):
# 1. Eliminar "user nginx;" del nginx.conf para arrancar directamente como no-root
# 2. Redirigir los temp dirs al tmpfs de /tmp (mode 1777, writable por todos)
# 3. Ajustar permisos de los archivos estáticos
RUN sed -i '/^user /d' /etc/nginx/nginx.conf && \
    sed -i 's|^pid .*;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf && \
    printf 'client_body_temp_path /tmp/client_temp;\nproxy_temp_path /tmp/proxy_temp;\nfastcgi_temp_path /tmp/fastcgi_temp;\nuwsgi_temp_path /tmp/uwsgi_temp;\nscgi_temp_path /tmp/scgi_temp;\n' \
        > /etc/nginx/conf.d/temp_paths.conf && \
    chown -R nginx:nginx /usr/share/nginx/html

USER nginx

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:80/ || exit 1

EXPOSE 80
