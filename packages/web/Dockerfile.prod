# Etapa 1: deps - Instalar dependencias
FROM node:22-alpine AS deps

WORKDIR /app

# Copiar manifests del monorepo
COPY package.json package-lock.json ./
COPY packages/api/package.json ./packages/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/web/package.json ./packages/web/

# Instalar todas las dependencias (necesarias para Vite en build)
RUN npm ci

# Etapa 2: build - Compilar frontend con Vite
FROM node:22-alpine AS build

WORKDIR /app

# Copiar dependencias instaladas
COPY --from=deps /app/node_modules ./node_modules

# Copiar manifests
COPY package.json package-lock.json ./
COPY tsconfig.json ./

# Copiar código compartido y frontend
COPY packages/shared ./packages/shared
COPY packages/web ./packages/web

# Compilar frontend
RUN npm run build -w packages/web

# Etapa 3: runtime - Servir archivos estáticos con nginx
FROM nginx:stable-alpine

# Copiar configuración de nginx
COPY packages/web/nginx.prod.conf /etc/nginx/conf.d/default.conf

# Copiar archivos compilados de Vite
COPY --from=build /app/packages/web/dist /usr/share/nginx/html

# Crear directorio temporal para nginx (para read-only filesystem)
RUN mkdir -p /var/run/nginx /var/cache/nginx && \
    chmod -R 755 /var/run/nginx /var/cache/nginx && \
    touch /var/run/nginx.pid && \
    chmod 644 /var/run/nginx.pid

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:80/ || exit 1

EXPOSE 80
