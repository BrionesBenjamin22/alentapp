generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum MemberCategory {
  Pleno
  Cadete
  Honorario
}

enum MemberStatus {
  Activo
  Moroso
  Suspendido
}

enum PaymentStatus {
  Pending
  Paid
  Canceled
}

model Member {
  id          String         @id @default(uuid())
  dni         String         @unique
  name        String
  email       String         @unique
  category    MemberCategory
  status      MemberStatus   @default(Activo)
  created_at  DateTime       @default(now())
  birthdate   DateTime?      @db.Date

  payments    Payment[]
  disciplines Discipline[]

  @@map("members")
}

model Payment {
  id           String        @id @default(uuid())
  amount       Float
  month        Int
  year         Int
  status       PaymentStatus @default(Pending)
  due_date     DateTime      @db.Date
  payment_date DateTime?
  member_id    String
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  member       Member        @relation(fields: [member_id], references: [id])

  @@index([member_id])
  @@map("payments")
}

model Discipline {
  id                  String   @id @default(uuid())
  reason              String
  start_date          DateTime
  end_date            DateTime
  is_total_suspension Boolean
  member_id           String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  member              Member   @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id])
  @@map("disciplines")
}